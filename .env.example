# Copy to .env (`cp .env.example .env`). Never commit .env.

# --- Postgres container (docker-compose.yml) ---
POSTGRES_USER=ledgerlite
POSTGRES_PASSWORD=ledgerlite
POSTGRES_DB=ledgerlite
# Published on 127.0.0.1 only. Change if 5432 is taken.
POSTGRES_PORT=5432

# --- Application ---
# Keep in sync with the POSTGRES_* values and port above.
DATABASE_URL=postgresql://ledgerlite:ledgerlite@localhost:5432/ledgerlite

# REQUIRED. The app refuses to start without it (min 16 chars).
# This value is a placeholder: generate your own with `openssl rand -hex 32`.
JWT_SECRET=change-me-placeholder-not-a-real-secret
JWT_TTL_SECONDS=3600

# Password given to the seeded users (alice@example.com, bob@example.com).
# Local development only.
SEED_PASSWORD=ledgerlite-dev

# --- Outbound webhooks (optional; see "Webhooks" in README.md) ---
# Leave WEBHOOK_URL empty to disable webhooks: transfers queue no events and
# the worker sends nothing (already queued events are kept for later). When
# set, it must be an absolute http:// or https:// URL (use HTTPS outside
# localhost; percent-encode non-ASCII path/query characters) and
# WEBHOOK_SIGNING_SECRET is required. Generate a secret with
# `openssl rand -hex 32`. Deliver events with a separate worker:
# `uv run python -m app.webhook_worker` (or `--once`). Restart both the app and
# the worker after changing either value; the worker then also uses the new
# values for events that were queued earlier.
WEBHOOK_URL=
WEBHOOK_SIGNING_SECRET=
